# ============================================================
#  Affordable Gold Enterprise - SERVER settings
#  Copy of .env. Fill the real values into .env, not this file.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development
# Where the React app runs (used for CORS and payment redirects)
CLIENT_URL=http://localhost:5173

# --- Supabase (Supabase dashboard -> Project Settings -> API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SECRET - server only, never put this in the React app
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack (Paystack dashboard -> Settings -> API Keys and Webhooks) ---
# Test mode keys start with pk_test_ and sk_test_
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- Mailgun (Mailgun dashboard -> Sending -> Domains) ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=affordablegold.mooo.com
MAILGUN_API_REGION=us
MAILGUN_FROM_EMAIL=orders@affordablegold.mooo.com
MAILGUN_FROM_NAME=Affordable Gold Enterprise

# --- Fallback email through Gmail (used only when Mailgun fails) ---
# Gmail needs an app password: myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Affordable Gold Enterprise

# --- Shop details ---
# New-order alerts are sent here
ORDER_ALERT_EMAIL=ibrahimnurudeenshehu1447@gmail.com
# The account allowed to become admin
ADMIN_EMAIL=ibrahimnurudeenshehu1447@gmail.com
