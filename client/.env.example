# ============================================================
#  Affordable Gold Enterprise - FRONT-END settings
#  Anything starting with VITE_ is visible to visitors,
#  so never put a secret key in here.
# ============================================================

# Address of the backend API
VITE_API_URL=http://localhost:5000/api

# Supabase (Supabase dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Paystack PUBLIC key only - safe to show, it is the lock not the key
VITE_PAYSTACK_PUBLIC_KEY=
